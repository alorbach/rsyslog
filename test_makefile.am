pkglib_LTLIBRARIES = omotlp.la

omotlp_la_SOURCES = omotlp.c

# Optional gRPC bridge support
if ENABLE_OMOTLP_GRPC
omotlp_la_SOURCES += grpc_bridge.cc
endif

# Base flags for all builds
omotlp_la_CPPFLAGS = $(RSRT_CFLAGS) $(PTHREADS_CFLAGS) $(CURL_CFLAGS) $(JSON_CFLAGS)

# Additional flags for gRPC builds
if ENABLE_OMOTLP_GRPC
omotlp_la_CPPFLAGS += -DENABLE_OMOTLP_GRPC -fvisibility=hidden -std=c++17
endif

omotlp_la_LDFLAGS = -module -avoid-version
omotlp_la_LIBADD = $(CURL_LIBS) $(JSON_LIBS) $(ZLIB_LIBS)

# Additional libraries for gRPC builds
if ENABLE_OMOTLP_GRPC
omotlp_la_LIBADD += -lopentelemetry_logs -lopentelemetry_exporter_otlp_grpc_logs -lgrpc++ -lprotobuf -labsl_base -labsl_strings -labsl_synchronization -lstdc++
endif

EXTRA_DIST = grpc_bridge.h
